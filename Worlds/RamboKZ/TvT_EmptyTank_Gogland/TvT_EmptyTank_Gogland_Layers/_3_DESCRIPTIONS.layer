$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила и Задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  "— Снимать униформу запрещено (штаны, куртки, шлем)."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Вертолетами могут управлять только пилоты."\
  "— Пилоты могут перевозить только СПН Десант."\
  ""\
  "ПРАВИЛА США"\
  "— Запрещено выводить топливозаправщики за синий триггер."\
  ""\
  "УСЛОВИЕ ЗАХВАТА"\
  "— Для захвата \"Командного пункта\" нужно 3-х кратное преимущества в триггере течение 5 мин"\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ ВС РФ"\
  "Для победы необходимо выполнить следующие задачи:"\
  "— Уничтожить 3 топливозаправщика."\
  "— Захватить командный пункт"\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ США"\
  "— Не дать уничтожить 3 топливозаправщика"\
  "— Удержать командный пункт в течении миссии"\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 "_0_ABOUT" {
