$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "После ожесточенных боев ВС РФ смогли занять две стратегические точки. Армия США делают попытку вернуть их. Для захвата нужно поменять флаг. Флаг не перезахватываемый. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно) "\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Запрещено использовать выбитый вертолет."\
  ""\
  "ПРАВИЛА США"\
  "— Вертолетами могут управлять только пилоты."\
  "— Перевозить можно только десент."\
  "— Таранить здания запрещено."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_RHS_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "USAF"
  m_sTextData "Необходимо захватить две точки. Форт (красный триггер) и Болота (синий триггер). Для захвата необходимо поменять флаг."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 "_2_RHS_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ"
  m_sTextData "Точного расположения противника нет в связи с отсутствием спутников в зоне операции. Нам необходимо удержать две точки. Форт (красный триггер) и Болота (синий триггер)."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}