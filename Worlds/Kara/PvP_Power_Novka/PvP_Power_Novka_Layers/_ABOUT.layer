$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Бой за электричество. Для победы атаки нужно сменить два флага. Флаги не перезахватываемые."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  ""\
  "ПРАВИЛА ЧСО"\
  "— Запрещено покидать синий триггер."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Вертолетами управляют только пилоты. Перевозить можно только десант. Таранить здания запрещено."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_RHS_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "ЧСО"
  m_sTextData "Необходимо удержать два триггера (Станция) и (Город). На карте есть метки ПВО и АГС, обратите внимание."
  m_aVisibleForFactions {
   "Ses_CDF"
  }
 }
 "_2_RHS_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ"
  m_sTextData "Необходимо захватить два триггера (Станция) и (Город) путем смены флага. По нашим разведданным горы хорошо защищены. Из-за плохой погоды не удалось установить дислокацию противника."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}