$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миcсии"
  m_sTextData "Войска ВС РФ удерживают два бункера с аммуницией на высоте. Силы армии США пытаются взять высоту. Для победы необходимо поменять флаги в бункерах. Флаг не перезахватываемый."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Запрещено покидать красный триггер."\
  ""\
  "ПРАВИЛА США"\
  "— Вертолетами управляют только пилоты. Перевозить можно только десант. Таранить здания запрещено."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_AFRF" {
  coords 5782.359 109.313 11407.833
  m_sTitle "ВС РФ"
  m_sTextData "Необходимо отразить наступление сил армии США на наши позиции. На высоте имеется укрепления со станковым ПКМ и позиция для стрельбы с миномета (показаны на карте)."\
  ""
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 "_2_USAF" {
  coords 8638.081 337.894 2492.071
  m_sTitle "США"
  m_sTextData "Необходимо захватить высоту и поменять два флага в бункерах."\
  ""
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
}