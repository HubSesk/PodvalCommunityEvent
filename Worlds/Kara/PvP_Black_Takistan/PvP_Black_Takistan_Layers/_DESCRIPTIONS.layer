$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миcсии"
  m_sTextData "В ходе неудачной операции армии США вблизи города Rasman были сбиты два вертолета UH-60 (Black Hawk). Пилотам чудом удалось выжить. Армия Таксистана пленила их и удерживают в городе."\
  "США всеми силами пытаются вернуть их на свою базу."\
  "Про этот инцидент узнали наемники ION и хотят забрать пленненых пилотов себе для допросов."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  "— Запрещено убивать плененных пилотов."\
  ""\
  "ПРАВИЛА США"\
  "— Вертолетами управляют только пилоты. Перевозить можно десант и плененных пилотов. Таранить здания запрещено."\
  ""\
  "ПРАВИЛА АРМИЯ ТАКИСТАНА"\
  "— Запрещено покидать триггер. (Пересекать зеленую линию). "\
  "— Запрещено выводить плененных пилотов за черный триггер."\
  ""\
  "ПРАВИЛА ПЛЕНЕННЫЕ ПИЛОТЫ"\
  "—Запрещено использовать оружие."\
  "—Запрещено покидать черный триггер без сопровождения США либо ION."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_USAF" {
  coords 5782.359 109.313 11407.833
  m_sTitle "США"
  m_sTextData "Необходимо вывезти заложников в синий триггер."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 "_2_ION" {
  coords 8638.081 337.894 2492.071
  m_sTitle "ION"
  m_sTextData "Необходимо вывезти заложников в красный триггер."\
  ""\
  ""
  m_aVisibleForFactions {
   "RHS_ION"
  }
 }
 "_2_TKR" {
  coords 6363.695 88.082 11094.564
  m_sTitle "Армия Такистана"
  m_sTextData "Недопустить вывозки заложников."
  m_aVisibleForFactions {
   "Ses_TKR"
  }
 }
}