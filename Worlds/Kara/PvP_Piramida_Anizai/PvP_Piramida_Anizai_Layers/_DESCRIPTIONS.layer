$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миcсии"
  m_sTextData "Бой за одну из пирамид. В обороне ЧСО, а атаке ВС РФ. Для лучшего ориентирования на карте есть метки подъемов на второй этаж."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  ""\
  "ПРАВИЛА ЧСО"\
  "— Запрещено покидать пирамиду. (Пересекать синюю линию)."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Запрещено покидать границы пирамиды. (Пересекать красную линию)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_CDF" {
  coords 5777.581 109.313 11407.013
  m_sTitle "ЧСО"
  m_sTextData "Нам необходимо разгромить противника и не дать убить КС'а стороны. Для лучшего ориентирования перед каждым отрядом есть ящик с осветительными гранатами ВН-400П."\
  ""
  m_aVisibleForFactions {
   "Ses_CDF"
  }
 }
 "_2_AFRF" {
  coords 5782.359 109.313 11407.833
  m_sTitle "ВС РФ"
  m_sTextData "Нам приказано всеми силами разгромить противника и нейтрализовать его КС'а. Смерть КС'а необходимо подтвердить через взаимодействие. От всех остальных солдат отличается головным убором (кепка)."\
  "Для лучшей видимости внутри пирамиды перед каждым отделением будет ящик с ИК-фонариками и одним щитом."\
  ""
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}