$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Нападение ВС РФ на один из военных объектов США. Отряды, расположенные в части, ожидают подход подкреплений чтобы отразить атаку. В это время ВС РФ не дремлет..."\
  "Для победы необходимо сменить флаг, флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Вертолетами могут управлять только пилоты."\
  "— Таранить здания запрещено."\
  ""\
  "ПРАВИЛА США"\
  "— Запрещено выходить за синюю линию (кроме отрядов подкрепления)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "США"
  m_sTextData "Необходимо удержать военный объект. На нем есть ящики с минами, припасы и строительные грузовики для возведения укреплений до прихода подкреплений."\
  "Перед отрядами СПН стоят ящики с магазинами для основного оружия. Каждому человеку по 12 штук. (Временное решение проблемы с их не стрелющим оружием. Старые магазины нужно выбросить)."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 "_2_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ "
  m_sTextData "Необходимо захватить военный объект и сменить флаг."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}