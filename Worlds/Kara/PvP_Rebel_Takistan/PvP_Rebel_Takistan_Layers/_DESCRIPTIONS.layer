$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миcсии"
  m_sTextData "В городе Loy Manara и его окрестностях обосновался Виталик со своей подкупной армии в роли FIA. Противостоять этому будут ВС РФ."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  "— Запрещено любым способом дюпать ресурсы, доступные изначально."\
  "— У стороны FIA количество радиостанций ограничено до 2-3 штук в отделении."\
  ""\
  "ПРАВИЛА FIA"\
  "— Запрещено покидать позиции. (Пересекать зелёную линию)."\
  ""\
  "ПРАВИЛА ВИТАЛИК"\
  "— Запрещено покидать позиции. (Пересекать синюю линию). "\
  "— Одевать униформу запрещено."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Вертолетами управляют только пилоты. "\
  "— Перевозить можно только десант. "\
  "— Таранить здания запрещено."\
  ""\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_FIA" {
  coords 5777.581 109.313 11407.013
  m_sTitle "FIA"
  m_sTextData "Наши информаторы доложили, что на нас готовится нападение со стороны ВС РФ с целью нейтрализации Виталика и личного состава армии. Нам необходимо всеми силами этому противостоять."\
  ""
  m_aVisibleForFactions {
   "FIA"
  }
 }
 "_2_AFRF" {
  coords 5782.359 109.313 11407.833
  m_sTitle "ВС РФ"
  m_sTextData "От нашего командования поступила информация о расположении Виталика с его армией. Нам приказано всеми силами разгромить противника и нейтрализовать его."\
  ""
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 "_2_CIV" {
  coords 8638.081 337.894 2492.071
  m_sTitle "Виталик"
  m_sTextData "Наши информаторы доложили, что на нас готовится нападение со стороны ВС РФ с целью нейтрализации тебя и армии. Тебе необходимо выжить до того времени, пока армия нейтрализует угрозу со стороны ВС РФ."\
  ""
  m_aVisibleForFactions {
   "CIV"
  }
 }
}