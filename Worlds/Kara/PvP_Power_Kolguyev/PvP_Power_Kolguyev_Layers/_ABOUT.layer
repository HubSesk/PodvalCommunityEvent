$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Бой за Каменск. США в атаке, СССР в обороне. Необходимо сменить два флага. Флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Вертолетами могут управлять только пилоты."\
  "— Таранить здания запрещено."\
  "— Количество радиостанций ограничено до 2-3 штук в отделении."\
  ""\
  "ПРАВИЛА СССР"\
  "— Запрещено выходить за красную линию (кроме саперов)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_US" {
  coords 4611.797 302.735 1570.727
  m_sTitle "США"
  m_sTextData "Необходимо захватить Каменск. Для захвата необходимо поменять два флага. Флаг не перезахватываемый."
  m_aVisibleForFactions {
   "US"
  }
 }
 "_2_USSR" {
  coords 4611.372 302.724 1571.033
  m_sTitle "СССР"
  m_sTextData "Нам необходимо удержать Каменск и не дать сменить два флага. На зданиях с флагами есть пулеметы."
  m_aVisibleForFactions {
   "USSR"
  }
 }
}