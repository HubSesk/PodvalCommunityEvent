$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Посреди обычного солнечного дня в городе Милтон бандиты в роли ION захватывают гражданских. Одна из групп расположилась в замке, где проводилась экскурсия. Вторая же группа захватила школу и удерживает гражданских там. Бандиты требуют выкуп и вертолет. У ВС РФ же другие планы..."\
  "Бандиты не знают с какого направления в город будут направлены силы ВС РФ."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Запрещено убивать гражданских. (В случае случайного убийства для своей же безопасности сохранить откат обстоятельств)."\
  "— Вертолетами управляют только пилоты. Перевозить можно только десант и гражданских. Таранить здания запрещено."\
  ""\
  "ПРАВИЛА ION"\
  "— Запрещено покидать пределы города (черный триггер)."\
  "— Запрещено выводить гражданских за пределы замка и школы (синий триггер)."\
  "— Запрещено прятаться и находиться в комнате/строении появления гражданских."\
  ""\
  "ПРАВИЛА ГРАЖДАНСКИЙ"\
  "— Запрещено покидать замок и школу (синие триггеры) без сопровождения солдат армии ВС РФ."\
  "— Запрещено использовать оружие."\
  "— Запрещено покидать комнату/строение своего спавна."\
  "— Запрещено самоубиваться."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_RHS_ION" {
  coords 4611.797 302.735 1570.727
  m_sTitle "Бандиты"
  m_sTextData "Необходимо удержать гражданских и недопустить их вывозки за пределы черной линии."
  m_aVisibleForFactions {
   "RHS_ION"
  }
 }
 "_2_RHS_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ"
  m_sTextData "Необходимо спасти всех гражданских и уничтожить противника. Гражданских нужно вывести за пределы черной линии."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 "_2_CIV" {
  coords 2988.947 79.983 4760.402
  m_sTitle "Гражданские"
  m_sTextData "Выжить и быть спасенными."
  m_aVisibleForFactions {
   "CIV"
  }
 }
}