$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миссии"
  m_sTextData "Пираты захватили заложников в поселке Kiiskinkyla и держат их на корабле."\
  "Армия США проводит операцию по их спасению. (Необходимо доставить заложников в синий триггер)."\
  "Заложники находятся в надстройке корабля."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Количество радиостанций ограничено до 2-3 шт. в отделении. "\
  ""\
  "ПРАВИЛА ПИРАТЫ"\
  "— Запрещено убивать заложников. "\
  ""\
  "ПРАВИЛА ЗАЛОЖНИКИ"\
  "— Запрещено покидать корабль без сопровождения солдата армии США."\
  "— Брать оружие и одевать униформу запрещено."\
  "— Запрещено самоубиваться."\
  ""\
  "ПРАВИЛА США"\
  "— Вертолетами могут управлять только пилоты. "\
  "— Перевозить можно только десант и заложников. "\
  "— Таранить здания запрещено."\
  "— Запрещено убивать заложников. "\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_PIR" {
  coords 5777.581 109.313 11407.013
  m_sTitle "Пираты"
  m_sTextData "Наши информаторы доложили, что со стороны армии США будет попытка освобождения заложников. Нам необходимо всеми силами этому противостоять. Нельзя допустить вывозки заложников в синий триггер."\
  ""
  m_aVisibleForFactions {
   "Drg_PIR"
  }
 }
 "_2_US" {
  coords 5782.359 109.313 11407.833
  m_sTitle "Армия США"
  m_sTextData "От нашего командования поступил приказ на особождение заложников и нейтрализации пиратов. Необходимо всеми силами разгромить противника и спасти заложников. Заложников нужно доставить в синий триггер. Есть две лодки для эвакуации (показаны на карте). На карте также показаны лестницы для подъема на корабль."\
  ""
  m_aVisibleForFactions {
   "US"
  }
 }
 "_2_CIV" {
  coords 8638.081 337.894 2492.071
  m_sTitle "Заложники"
  m_sTextData "Выходить можно при сопровождении солдата армии США."\
  ""
  m_aVisibleForFactions {
   "CIV"
  }
 }
}