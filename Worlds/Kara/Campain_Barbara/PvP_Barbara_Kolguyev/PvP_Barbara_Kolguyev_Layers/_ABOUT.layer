$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Мини-кампания под названием \"Барбара\". Суть кампании в контроле острова Колгуев. По результатам каждой миссии одной из сторон будет присуждаться одно очко (ВС РФ за успешную оборону точки; ВС США за успешную атаку точки). Кампания будет длиться до тех пор, пока одна из сторон не наберёт 2 очка."\
  "Для победы необходимо захватить два флага. Флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Вертолетами могут управлять только пилоты и КС ВС США."\
  "— Таранить и уничтожать здания с флагом запрещено."\
  "— Бой разрешено вести только в одной из точек с флагами (красной зоне)."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Запрещено выходить за чёрную линию (кроме отрядов подкрепления)."\
  ""\
  "УСЛОВНЫЕ ОБОЗНАЧЕНИЯ"\
  "*Синяя зона — подконтрольная территория ВС США."\
  "*Красная зона — подконтрольная территория ВС РФ."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "ВС США"
  m_sTextData "Командование приказало захватить остров Колгуев. Мы закрепились на острове \"Красный\". Планируем штурм аэродрома для предотвращения пересылки подкреплений ВС РФ."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 "_2_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ "
  m_sTextData "Весь личный состав поднят по тревоге. Приказано противостоять вторжению армии США на территорию острова."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 "_3_DAY_1" {
  coords 2819.277 262.859 4659.572
  m_sTitle "День первый"
  m_sTextData "22 июня 2041 год. 7:00. Остров Колгуев. Аэродром."\
  ""\
  "Командование ВС США приказало всеми силами захватить стратегически важный объект для укрепления своего положения в Северном Ледовитом океане."\
  ""\
  "ВС РФ давно обосновались на острове и располагают достаточным количеством ресурсов для отражения атаки."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}