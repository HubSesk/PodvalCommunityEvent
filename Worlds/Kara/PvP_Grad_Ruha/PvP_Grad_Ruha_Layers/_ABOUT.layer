$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Наступательная операция ВС РФ на позиции США. Под контролем США есть три поселка. Для победы нужно захватить флаги. Флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно) ."\
  "— Запрещено снимать униформу (штаны, куртки, шлем)."\
  "— Вертолетами управляют только пилоты. Перевозить можно только десант. Таранить здания запрещено."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_RHS_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "США"
  m_sTextData "Необходимо удержать три поселка и не дать захватить флаги. В каждом поселке на крышах с флагами есть по две зенитные установки с 4-мя магазинами."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 "_2_RHS_AFRF" {
  coords 4611.372 302.724 1571.033
  m_sTitle "ВС РФ"
  m_sTextData "Необходимо захватить три флага. В нашем распоряжении помимо Тигров есть два Бумеранга и два боевых вертолета. Докладывается о возможном наличии ПВО у противника."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}