$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Операция ВС США по освобождению одного из городов. Для победы необходимо сменить флаг. Флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Вертолетами могут управлять только пилоты."\
  ""\
  "ПРАВИЛА США"\
  "— Боевой вертолет можно брать только после высадки десанта."\
  ""\
  "УСЛОВНЫЕ ОБОЗНАЧЕНИЯ"\
  "* Черный триггер - зона города."\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "— Для предотвращения бага с техникой рекомендуется садиться в нее по одному."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_USAF" {
  coords 4611.797 302.735 1570.727
  m_sTitle "Рекомендация по штурму"
  m_sTextData "Вокруг объекта имеются высокие стены. Для штурма стен настоятельно рекомендуется использовать мины. Для сноса одной стены необходима одна мина."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
}