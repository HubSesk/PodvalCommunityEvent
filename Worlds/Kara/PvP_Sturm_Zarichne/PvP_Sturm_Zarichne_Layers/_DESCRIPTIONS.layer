$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "О миcсии"
  m_sTextData "Штурм позиций ЧСО. Для победы атаке необходимо захватить два флага. Флаг не перезахватываемый."\
  "Игра завершится по потерям одной из сторон."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила миссии"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно). "\
  "— Снимать униформу запрещено (штаны, куртки, шлем)."\
  "— Вертолетами управляют только пилоты. "\
  "— Перевозить можно только десант. "\
  "— Таранить здания запрещено."\
  ""\
  "ПРАВИЛА ЧСО"\
  "— Запрещено покидать город (Выходить за фиолетовую линию)."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Боевой вертолет можно брать только после высадки десанта."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_CDF" {
  coords 5777.581 109.313 11407.013
  m_sTitle "ЧСО"
  m_sTextData "Наши информаторы доложили, что на нас готовится нападение со стороны ВС РФ. Нам необходимо всеми силами удержать зоны и не дать противнику поменять флаги."\
  "На карте есть метки на зенитки."\
  "Задача наблюдателей - наводить минометный расчет."\
  ""
  m_aVisibleForFactions {
   "Ses_CDF"
  }
 }
 "_2_AFRF" {
  coords 5782.359 109.313 11407.833
  m_sTitle "ВС РФ"
  m_sTextData "От нашего командования поступила информация о расположении ЧСО. Нам приказано всеми силами разгромить противника и захватить два флага (Мастерская) и (Особняк)."\
  "На карте есть ресурсы и необходимый транспорт для пополнения боекомплекта, ремонта и дозаправки."\
  ""
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}