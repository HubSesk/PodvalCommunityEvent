$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_About" {
  coords 4599.375 313.383 1592.557
  m_sTitle "О миссии"
  m_sTextData "Атака США на военные объекы СССР с целью смены флага и уничтожения грузовиков c топливом. Флаг не перезахватываемый."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Правила миссии "
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— Всем запрещено надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно)."\
  "— Вертолетами могут управлять только пилоты."\
  "— Таранить здания запрещено."\
  "— Количество радиостанций ограничено до 2-3 штук в отделении."\
  ""\
  "ПРАВИЛА СССР"\
  "— Запрещено выходить за красную линию."\
  "— Запрещено прятать грузовики за черной линией."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_2_US" {
  coords 4611.797 302.735 1570.727
  m_sTitle "США"
  m_sTextData "Необходимо захватить два военных объекта (черный триггер). Для захвата необходимо поменять флаг. Флаг не перезахватываемый. А также уничтожить грузовики."
  m_aVisibleForFactions {
   "US"
  }
 }
 "_2_USSR" {
  coords 4611.372 302.724 1571.033
  m_sTitle "СССР"
  m_sTextData "Нам необходимо удержать два военных объекта (черные триггеры), не дать уничтожить грузовики и сменить флаги."
  m_aVisibleForFactions {
   "USSR"
  }
 }
}