   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 4031.498 203.415 8125.053
  m_sTitle "Обстановка"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "2023 г."\
  "Убийство президента Быстрани привели к массовым волнениям в стране. Заподозрив в совершении преступления иностранные спец. службы, пришедшая к власти партия предъявила ультиматум странам, имевшие свои базы на территории государства - вывести свои войска с территории страны в ближайшие 48 часов. Однако США признали власть нелегитимной и в срочном порядке ввела новые войска. Взяв под контроль несколько городов, новый президент Быстрани ввел ЧП на территории государства и приказал армии вернуть контроль над городами. Потерпев несколько поражений, глава государства обращается к РФ для введения последней своих войск и оказания помощи местной армии. Авангард ВС РФ совместно с армией Быстрани провели попытку штурма г. Kamoryn, но потерпели поражение. Теперь, когда основные силы РФ в стране, наступает черед второй попытки..."
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
