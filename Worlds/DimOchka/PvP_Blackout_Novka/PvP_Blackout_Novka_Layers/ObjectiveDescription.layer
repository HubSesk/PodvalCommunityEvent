$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 2395.765 185.947 1948.926
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  "1. Всем ЗАПРЕЩЕНО надевать форму, головные уборы, разгрузки, бронежилеты противника (рюкзаки можно);"\
  "2. Для захвата нужно поменять флаг. Флаг не перезахватываемый;"\
  "3. ВС РФ ЗАПРЕЩЕНО минировать внутреннюю территорию Аванпоста;"\
  "4. ВСЕМ ЗАПРЕЩЕНО заезжать в окрестности базы \"Фрост\" (Юго-восток, красная зона)."\
  ""\
  "ЗАДАЧИ:"\
  "• ВС РФ: "\
  " 1. Удержать Западную сторону Дамбы;"\
  " 2. Удержать Восточную сторону Дамбы."\
  ""\
  "• США:"\
  " 1. Захватить Западную сторону Дамбы;"\
  " 2. Захватить Восточную сторону Дамбы."\
  ""\
  "Дополнительно:"\
  "1. Гаечный ключ для ПТУРа находится в УАЗике."
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 2395.765 185.947 1948.926
  m_sTitle "Обстановка"
  m_sTextData "Ночь, 2 января, 2026 г."\
  "После ожесточенных боев за базу, объединенные силы КМП США и ССО США, базирующиеся на западе Новки, планируют нанести ответный удар. Цель операции - захват дамбы. Проведение миссии предоставит время оставшимся войскам США для сбора, уничтожения, а также переправки секретных данных на Большую землю. "
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 2395.765 185.947 1948.926
  m_sTitle "Ситуация"
  m_sTextData "Мы активно продвинулись с момента начала операции. По нашим разведданным США планируют провести ответный удар по нашим позициям на Дамбе. Для защиты объекта мы развернули Аванпост, севернее дамбы, и вооружили её КОРДом и ПТУРом."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 {
  coords 2395.765 185.947 1948.926
  m_sTitle "Ситуация"
  m_sTextData "Мы вывезли оставшихся людей с базы \"Фрост\" на запад Новки и, теперь, настал черед совершить ответный удар. По нашим разведданным, севернее дамбы, русские расположили аванпост с КОРДом и ПТУРом. Было бы неплохо завладеть этим вооружением и применить их против них самих же. Нужно быть осторожным, возможно, они могли заминировать подходы."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
}
