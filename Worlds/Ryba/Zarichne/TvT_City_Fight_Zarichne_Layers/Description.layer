$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 MainDescription {
  coords 2427.083 2.324 480.503
  m_sTitle "Описание миссии"
  m_sTextData "Бои за городскую площадь между ВС РФ и ВС ВБ."
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 Description_AFRF {
  coords 2417.025 0.242 480.009
  m_sTitle "Описание миссии"
  m_sTextData "Противник намерен захватить город. Сейчас там находятся остатки 3-го взвода, они попали в засаду на площади. Их техника сожжена, а боезапас почти на исходе. Они держат позицию у администрации. Также вместе с ними на площади застряла группа спецназа ГРУ."\
  "Мы должны прийти к ним на помощь, заодно довести до них припасы."\
  "По всему городу расставлены баррикады и заграждения, так что не все дороги свободны. Это также может сыграть нам на руку, так как противника это может ненадолго задержать."\
  "Помощи извне не будет. Мы должны действовать своими силами. Тем что есть. Не допустите захват площади противником. Город не должен пасть."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 Description_UK {
  coords 2422.229 0.242 482.316
  m_sTitle "Описание миссии"
  m_sTextData "Мы должны занять этот город для нашего дальнейшего наступления. Русские огрызаются как бешенные. Мы уже потеряли всю бронетехнику. Благо американские морпехи передали нам две бронемашины LAV-25. Это хоть какое-то преимущество."\
  "В городе полно баррикад и многие дороги перегорожены."\
  "Наша задача добить остатки русских на площади и захватить её. Из-за плотной застройки им будет тяжело выбить нас оттуда."\
  "Поэтому используйте имеющиеся средства с умом и захватите городскую площадь."
  m_aVisibleForFactions {
   "UK"
  }
 }
 Rules {
  coords 2423.816 0.242 480.942
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "— надевать форму и элементы снаряжения противника стороны (рюкзаки можно);"\
  "— выходить в красную зону."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА РФ:"\
  "— не дать поменять флаг."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ВБ:"\
  "— поменять флаг (через взаимодействие)."\
  ""\
  "ВАЖНО:"\
  "— флаг не перезахватываемый."
  m_aVisibleForFactions {
   ""
   "RHS_AFRF"
   "UK"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RulesRU {
  coords 2423.799 -1.837 479.113
  m_sTitle "Примечание"
  m_sTextData "По лору и задумке миссии у обороняющихся на площали мало боеприпасов."\
  "Всего без оружия на площади 7 человек."\
  "Поэтому:"\
  "На площади рядом с фонтаном имеется оружейная стойка с автоматами (каждому по одному) и ящиком (каждому по два магазина). Также с ними могут поделится их соотрядники."\
  ""\
  "Отряды которые спавнятся не на площади должны довести ящики с боеприпасами (магазины к АК, короба на ПКМ и \"Утёс\", выстрелы к РПГ, ручные гранаты)."\
  ""\
  "— ящики можно загрузить в грузовики и вести на них;"\
  "— ящики можно нести в руках (тяжёлые, идти будете медленно, спринт выбивает ящики из рук);"\
  "— ящики можно закинуть в вещмешки."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
}