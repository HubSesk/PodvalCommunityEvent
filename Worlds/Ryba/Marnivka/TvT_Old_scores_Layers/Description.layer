$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Description {
  coords 1937.241 26.501 1184.588
  m_sTitle "Описание миссии"
  m_sTextData "Перемирие кончилось. Новиград приказывает своим войскам немедленно атаковать позиции ЧДКЗ. Одной из позиций является небольшой укреплённый населённый пункт Яркне. Захват данного НП является второстепенной задачей, так как он имеет слабое сообщение с остальными подразделениями ЧДКЗ, однако нависает над линиями снабжения чернарусской армии. Поэтому командование ЧСО срочно выделило на этот участок небольшую роту. ЧДКЗ же не теряли времени зря и готовы отстаивать свои идеи. Конфликт вновь возобновляется. Пора свести старые счёты."
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 MainRules {
  coords 1937.535 26.511 1185.106
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "– надевать форму и снаряжение противника (рюкзаки можно)."\
  "– пересекать красную границу и находиться в красной зоне."\
  ""\
  "КРАСНЫМ ЗАПРЕЩЕНО:"\
  "– пересекать синюю линию."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ЧДКЗ:"\
  "– удержать Якне (НЕ ДАТЬ СМЕНИТЬ ФЛАГ)."\
  "– нанести критические потери противнику."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ЧСО:"\
  "– захватить Якне (ПОМЕНЯТЬ ФЛАГ ЧЕРЕЗ ВЗАИМОДЕЙСТВИЕ)."\
  "– уничтожить гарнизон противника."\
  ""\
  "ВНИМАНИЕ:"\
  "– флаг не перезахватываемый."
  m_aVisibleForFactions {
   "" "Ses_CDF" "Ses_ChDKZ"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 Hint_CDF {
  coords 1938.674 26.505 1186.079
  m_sTitle "Описание миссии"
  m_sTextData "Терпение Новиграда кончилось. Нам пора подавить эту  террористическую банду, что называют себя Чернарусским Движением Красной Звезды. Вашей роте назначена задача - захватить населённый пункт Яркне. Чедаки в нём хорошо окопались и ощетинились тяжёлым вооружением. Возьмите миномёт, заправьте БТРы и Хаммеры и выбейте чедаков из их окопов. В старом укрепе есть ремонтный цех. В нём стоит американская боевая машина LAV-25, оставшаяся ещё со времён Красной Жатвы. Новый экипаж для этой машины уже прибыл в вашу часть. Преступайте к атаке, как только будете готовы. Не задерживайтесь. Генерал даёт вам час на всю операцию. Выполняйте! Слава Чернаруси! Слава ЧСО!"
  m_aVisibleForFactions {
   "Ses_CDF"
  }
 }
 Hint_ChDKZ {
  coords 1937.93 26.461 1184.424
  m_sTitle "Описание миссии"
  m_sTextData "Чернарусское правительство нарушило перемирие. ЧСО подняты по тревоге и уже движутся к нашим позициям. Мы хорошо окопались и готовы принять атаку. Информатор в рядах противника сообщает, что на ваш опорный пункт в Яркне готовят атаку. У наших врагов имеется артиллерия и американская техника. У вас на позициях имеются крупнокалиберные пулемёты. Займите оборону и готовьтесь к бою. Удержите Яркне - это наш передовой пункт для атак на логистику ЧСО. Удачи товарищи!"
  m_aVisibleForFactions {
   "Ses_ChDKZ"
  }
 }
}