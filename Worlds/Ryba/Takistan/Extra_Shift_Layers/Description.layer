$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Main_Description {
  coords 10605.054 554.357 7753.242
  m_sTitle "Описание миссии"
  m_sTextData "Советская армия в Такистане нуждается в срочном снабжении."
 }
 USSR_Description {
  coords 10604.111 554.595 7751.848
  m_sTitle "Описание миссии"
  m_sTextData "Очередная сверхурочная работа, товарищи. Нашим артиллеристам глубоко в горах требуется срочный подвоз боеприпасов. Штаб планирует наступление в долине по трассе на Заграбад. Сегодня прибывает грузовой ИЛ-76. Заберите груз на Уралах и доставьте его по маршруту: Тимуркалай, Феруз Абад, Шукуркалай, Чаман. На маршруте стоят наши блокпосты, так что дорога должна быть более-менее безопасной, но будьте осторожны: местные говорят, что видели вооружённых людей на северо-востоке и западе. Повысте боевую готовность и будьте бдительны. Доставьте груз целым и невредимым. Выполняйте."
  m_aVisibleForFactions {
   "USSR"
  }
 }
 TKR_Description {
  coords 10603.751 554.729 7750.623
  m_sTitle "Описание миссии"
  m_sTextData "Братья, шурави намерены снабжать группировку войск и артиллерийский дивизион в горах. Сегодня прибывает самолёт с грузом. Мы должны не допустить доставку груза к артиллерии, иначе под обстрелом окажутся наши поселения и лагеря. Нам известна дорога, по которой пройдёт конвой. На маршруте стоят блокпосты шурави – это делает опреацию более рискованной. Если против вертолёта сопровождения, которым они обычно пользуются, мы ещё можем выставить старенький Урал с ЗУ-23, то усиленная охрана маршрута – угроза для наших людей. Наши люди плохо подготовлены и слабо вооружены. Однако поблизости есть схрон с вооружением, но он находится на вражеской территории, нам придётся пересечь  блокпосты под видом безоружных, либо пойти в обход по горам. Если же страх вам не ведом, можете попробовать взять блокпосты штурмом, по слухам в Джилавуре и Феруз Абаде есть крупные арсеналы. Завладейте оружием, если сможете – на всё воля Аллаха, но остановите конвой любой ценой."
  m_aVisibleForFactions {
   "Ses_TKR"
  }
 }
 TKR_Rules {
  coords 10603.369 554.861 7749.491
  m_sTitle "Условности для боевиков"
  m_aVisibleForFactions {
   "Ses_TKR"
  }
 }
 USSR_Rules {
  coords 10603.856 554.717 7750.512
  m_sTitle "Условности для советской армии"
  m_aVisibleForFactions {
   "USSR"
  }
 }
 Main_Rules {
  coords 10603.838 554.538 7753.587
  m_sTitle "Общие правила"
 }
}