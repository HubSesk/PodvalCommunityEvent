$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Descriptions_Main {
  coords 3193.666 56.082 8142.918
  m_sTitle "Описание миссии"
  m_sTextData "США планируют устранить торговца оружием."
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 Descriptions_CIV {
  coords 3194.033 56.04 8142.953
  m_sTitle "Описание миссии"
  m_sTextData "Американцы выяснили, кто продаёт такистанским боевикам оружие, и теперь идут за моей головой. Быстро покинуть город у меня возможности нет, мне придётся переждать рейд и дождаться конвоя до безопасного места. Меня будут охранять эти крепкие русские парни, а также местные боевики, но в случае опасности я и сам могу постоять за себя. Я обязательно выживу."
  m_aVisibleForFactions {
   "CIV"
  }
 }
 Descriptions_RU {
  coords 3194.368 56.023 8143.207
  m_sTitle "Описание миссии"
  m_sTextData "Американцы вычислили торговца оружием, что поставляет вооружение для боевиков в Такистане. Хуже того, они знают где он сейчас и уже отправили рейдовую группу. Нас наняли для защиты торговца под кодовым именем \"Бирюк\". Местные боевики помогут нам, мы должны спрятать Бирюка и не допустить, чтобы хоть один волос упал с его лысины. За дело, парни!"
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 Descriptions_US {
  coords 3193.972 56.066 8143.195
  m_sTitle "Описание миссии"
  m_sTextData "Наша разведка вычислила местоположение русского торговца оружием под кодовым именем \"Бирюк\". Наша цель находится в городе Заграбад. Город охраняется местными боевиками, так что боя не избежать. Телохранители Бирюка - российская ЧВК, это опасные ребята. Кроме того, у Бирюка в этом городе 4 консперативные квартиры, мы не знаем точно в какой из них он находится, поэтому необходимо проверить каждую. Также есть несколько примерных мест в городе, где он может укрываться помимо основных четырёх. Выдвигайтесь в Заграбад, переверните там всё вверх дном, но накажите эту мразь. Устранили, подтвердили личность, вернулись на базу. Всем удачи."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 Descriptions_TKR {
  coords 3194.338 56.035 8143.317
  m_sTitle "Описание миссии"
  m_sTextData "Американцы планируют устранить нашего поставщика оружия из России. Этот человек сильно помог нашему движению в борьбе против американцев. Поэтому мы отплатим ему услугой за услугой. Мы должны охранять его, пока его не вывезут в безопасное место. К оружию, братья, покажим этим паршивым шакалам как приветствуют в Заграбаде!"
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 Rules_Main {
  coords 3193.963 56.095 8143.555
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "– надевать форму и снаряжение противника (рюкзаки можно)."\
  ""\
  "Боевикам, России и Бирюку:"\
  "– запрещено выходить за пределы города (красную линию)."\
  ""\
  "Бирюку запрещено:"\
  "– прятаться в местах, не указанных на карте как укрытия."\
  ""\
  "Способы победы за Боевиков, Россию и Бирюка:"\
  "– недопустить убийства Бирюка."\
  "– разгромить противника."\
  ""\
  "Способы победы за ВС США:"\
  "– устранить Бирюка и подтвердить личность (через взаимодействие)."\
  "– разгромить противника."\
  ""\
  "ВАЖНО:"\
  "– Бирюк может прятаться в одной из 4 главных консперативных квартир."\
  "– Бирюк может прятаться в других местах в городе, обозначенных маленьким красным вопросительным знаком."
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}