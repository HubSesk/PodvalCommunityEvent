$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 MainDiscription {
  coords 3173.551 7.234 5.793
  m_sTitle "Описание миссии"
  m_sTextData "Рейд ВС РФ на плантацию запрещённых веществ боевиков."
  m_bEmptyFactionVisibility 1
 }
 MainRules {
  coords 3172.948 7.323 7.17
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "— надевать форму и снаряжение противника (рюкзаки можно);"\
  "— убивать без причины работников плантации."\
  ""\
  "Способы победы за ВС РФ:"\
  "— найти и ликвидировать лидера боевиков —  50 очков;"\
  "— арестовать работников плантации и доставить их на базу ВС РФ (зелёный триггер) — 35 очков;"\
  "— в случае вооружённого сопротивления, разрешено ликвидировать работников —  15 очков."\
  ""\
  "Способы победы за боевиков:"\
  "— не допустить убийство лидера боевиков — 50 очков;"\
  "— не допустить арест работников плантации — 35 очков;"\
  "— ликвидировать работников, если те решили устроить побег — 15 очков."\
  ""\
  "Работникам плантации:"\
  "— запрещено покидать красный триггер, кроме как побега во время рейда ВС РФ и выполнения задач;"\
  "— разрешено брать оружие для самозащиты или побега во время рейда ВС РФ;"\
  "— разрешено выбрать союзника: боевики/ВС РФ (в случае ВС РФ — запрещено использовать оружие, ВС РФ расценивают это как вооружённое сопротивление)."
 }
 CivDiscription {
  coords 3173.586 7.09 3.956
  m_sTitle "Описание миссии"
  m_sTextData "Мы высококвалифицированные профессионалы в различных направления науки со всего мира. Местные шейхи и полевые генералы хорошо оплачивают труд таких работников как мы. Прямо сейчас мы занимаемся выращиванием и обработкой сырья для мощного наркотического вещества на плантации Шахбаз в Такистане. Несмотря на нашу ценность, местные увольни держат нас здесь за простых рабов и обращаются как со скотом. Время от времени подозрение о том, что никаких денег нам не видать и что мы добровольно нанялись в рабство лишь усиливается. В дополнение к нашему положению, мы ещё вне закона. За последние дни увеличился контингент русских в регионе, они явно что-то готовят. Так долго нельзя, нам нужно решить что делать дальше:"\
  "сдаться и сотрудничать с властями, продолжать работать с текущим нанимателем или же бежать."\
  "Промедление стоит нам нашей свободы, а то и жизней."
  m_aVisibleForFactions {
   "CIV"
  }
 }
 RFDiscription {
  coords 3174.253 7.079 3.84
  m_sTitle "Описание миссии"
  m_sTextData "Рынок Европы и Америки наводнило новое мощное наркотическое вещество. Пока весь мир бьёт тревогу, наши спецслужбы уже выяснили откуда берётся эта дрянь. По донесениям разведки в Такистане в районе Заграбада есть плантация, на которой особым методом изготавливается сырьё. Дан приказ провести рейд на плантацию с целью ареста работников, которым по некоторым сведениям известен рецепт обработки. Также необходимо выследить и ликвидировать главаря местной банды радикалов, что и контролируют данную плантацию."\
  ""\
  "Нельзя упустить ни одного из этих мерзавцев, иначе эта погань всплывёт где-то ещё, другого шанса у нас не будет."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 TKRDiscrioption {
  coords 3175.275 7.049 3.522
  m_sTitle "Описание миссии"
  m_sTextData "Поступил заказ на новую партию нашего особого сырья для нового мощного наркотического вещества. Нам не важно, сколько людей пострадает от этой дури, но деньги вырученные с продаж пойдут на спонсирование нашей борьбы в этой стране. Пора запрячь этих рабочих на плантации, чтобы приступали к работе. Вот только настораживают русские. Их всё больше и больше. Патрули увеличились и участились. Их наращивание присутствия вызывает опасение. Нужно усилить безопасность и повысить бдительность. Если они что-то узнали, то дело придётся сворачивать и переносить на новое место, нельзя потерять этих ценных сотрудников, их знания - залог победы нашего дела."
  m_aVisibleForFactions {
   "Ses_TKR"
  }
 }
 CivTasks {
  coords 3175.004 7.097 4.04
  m_sTitle "Задачи для работников плантации"
  m_sTextData "Работникам плантации необходимо:"\
  "ДО РЕЙДА:"\
  "— выполнять работу на плантации:"\
  "1) перенести ящики с химикатами из грузовика в бункер;"\
  "2) перенсети мешки с сырьём из бункера в грузовик;"\
  "3) оставаться на плантации;"\
  "4) один из работников в сопровождении одного охранника должен на грузовике доставить мешки на виллу (требуется сначала дождаться приезда лидера боевиков)."\
  ""\
  "ВО ВРЕМЯ РЕЙДА:"\
  "— выбрать способ выжить:"\
  "1) взяться за оружие и помочь боевикам;"\
  "2) найти укрытие и дождаться, когда боевики отобьёются от ВС РФ;"\
  "3) сбежать (разрешено вооружиться);"\
  "4) сдаться и позволить себя арестовать;"\
  "5) сдаться и сотрудничать."\
  ""\
  "ВАЖНО:"\
  "Способы выжить индивидуальны, каждый работник выбирает свой способ выжить (разрешено всем или нескольким работникам выбрать одинаковый способ). "
  m_aVisibleForFactions {
   "CIV"
  }
 }
 TKRTasks {
  coords 3177.143 7.154 4.767
  m_sTitle "Задачи для боевиков"
  m_sTextData "Боевикам необходимо:"\
  "— обеспечить безопасность:"\
  "1) защищать Шамиля;"\
  "2) защищать плантацию;"\
  "3) не допустить ареста или побега работников плантации;"\
  "4) разгромить противника."\
  ""\
  "Охране плантации необходимо:"\
  "— охранять плантацию:"\
  "1) не допустить ареста или побега работников плантации;"\
  "2) не допустить захват плантации противником;"\
  "3) обеспечить работников плантации работой: проконтролировать перенос ящиков и мешков;"\
  "4) один охранник должен сопроводить грузовик на виллу и остаться охранять работника (требуется сначала дождаться прибытия Шамиля на плантацию)."\
  ""\
  "Шамилю необходимо:"\
  "1) выжить;"\
  "2) прибыть на плантацию и удостовериться выполнением работы: переонс ящиков и мешков;"\
  "3) сопроводить грузовик я мешками до виллы (требуются один работник и один охранник)."\
  ""
  m_aVisibleForFactions {
   "Ses_TKR"
  }
 }
}