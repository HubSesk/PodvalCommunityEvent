$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 MainDescription {
  coords 15.504 74.659 8178.709
  m_sTitle "Описание миссии"
  m_sTextData "Обстановка в мире наколена до предела. Силы НАТО и ВС РФ приведены в повышенную боевую готовность. Войска скапливаются у границ. Теперь весь мир - пороховая бочка. Остался лишь один вопрос: кто чиркнёт спичкой?"
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 RFDescription {
  coords 15.761 74.752 8180.275
  m_sTitle "Описание миссии"
  m_sTextData "Геополитическая ситуация между Востоком и Западом напряжена. Война может начаться в любую секунду. НАТО накапливает силы у наших границ, мы отвечаем тем же самым. Пока ни мы, ни они не сделали ни единого выстрела - надежда на мир ещё есть. Однако будьте начеку, враг хитер и может предпринять авантюру. Стрельба по нашим солдатам и пересечение границы - означает объявление войны. Поэтому, в случае эскалации, мы должны быть на более выгодных условиях - необходимо прорвать позиции противника и захватить их штаб. Дальше остаётся лишь молиться."\
  "На днях в Англии произошёл крупный скандал, одну британскую компанию уличили в чёрном бизнесе и коррупции. На журналиста было совершено неудачное покушение и он попросил полит-убежище в России. Сейчас он сам в безопасности, однако компромат сейчас находится на нашей границе. Не допустите потерю или кражу этого компромата до прибытия сотрудников из ФСБ."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 UKDescription {
  coords 15.758 74.786 8181.002
  m_sTitle "Описание миссии"
  m_sTextData "На днях в Лондоне произошёл крупный скандал: независимый журналист провёл расследоваине и собрал компромат на крупнейшую корпорацию Британии. Данная компания действует в интересах Короны и МИ6. Сейчас между американцами и русскими очень напряжённые отношения, отчасти в этом есть след этой корпорации. Если бы не инциденты в ЦАР и на Кавказе - русская армия не стояла бы на границе и не мешала нам выкрасть этот компромат. Без доказательств любые слова этого журналиста - пустой звук и кремлёвская пропаганда. Выкрадите этот компромат и доставьте его в городок Руха, наш агент подберёт их там. Действуйте тихо и стандартно."
  m_aVisibleForFactions {
   "UK"
  }
 }
 USDescription {
  coords 17.243 74.74 8178.959
  m_sTitle "Описание миссии"
  m_sTextData "Мир шаг за шагом скатывается в бездну. Очередная мировая война нависла над нашей планетой. Все войска приведены в повышенную боевую готовность. Европейские страны проводят мобилизацию, а русские накапливают силы у границ. Наша рота назначена на этот участок. В усиление нам выделили взвод морских пехотинцев. Нам запрещено атаковать русских первыми, но если стрельба начнётся - мы должны первыми прорвать их рубежи и занять их штаб. Будьте внимательны, русские очень смекалисты, они могут предпринять любую авантюру. Также в этом районе действует британский спецназ. У англичан здесь свои дела, но в случае чего мы должны помогать нашим союзникам. Русские не должны пересечь эту границу, но и вы не совершайте необдуманных поступков. Мы не должны быть ответственными за развязывание войны."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 MainRules {
  coords 16.647 74.598 8177.056
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "— надевать форму и снаряжение противника (рюкзаки можно);"\
  "— находиться в чёрной зоне;"\
  "— нарушать условности для фракций."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ВС РФ:"\
  "— не дать украсть компромат;"\
  "— захватить штаб США (поменять флаг) в случае эскалации и защитить свой;"\
  "— нанести критические потери противнику."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ВС США:"\
  "— захватить штаб РФ (поменять флаг) в случае эскалации и защитить свой;"\
  "— нанести критические потери противнику."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА Великобританию:"\
  "— похитить компромат и доставить в населённый пункт Руха;"\
  "— помочь ВС США в случае эскалации (опционально)."\
  ""\
  "ВНИМАНИЕ:"\
  "флаги не перезахватываемы."\
  "компромат - коричневая папка."\
  "ВС США и Великобритания - союзники (разрешено действия ВБ расценивать как действия США)."
  m_aVisibleForFactions {
   "" "RHS_USAF" "RHS_AFRF" "UK"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RFRules {
  coords 15.754 74.544 8177.05
  m_sTitle "Условности для РФ"
  m_sTextData "Зпрещено открывать огонь и пересекать границу, если противник не открывал огонь по вам или не пересекал границу."\
  ""\
  "Спецназу можно пересекать границу до эскалации (однако необходимо действовать незаметно)."\
  ""\
  "Разрешено атаковать ВС США в случае нападения на отделение охраны (опционально)."\
  ""\
  "Компромат можно вернуть назад и доставить в штаб."
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 UKRules {
  coords 15.061 74.492 8177.182
  m_sTitle "Условности для Великобритании"
  m_sTextData "Компромат находится на втором этаже офисного здания, в дальней комнате на столе по центру."\
  ""\
  "Разрешено оставить компромат в населённом пункте Руха и вернуться на поле боя (но учтите - противник попытается вернуть компромат)."
  m_aVisibleForFactions {
   "UK"
  }
 }
 USRules {
  coords 14.694 74.446 8177.011
  m_sTitle "Условности для США"
  m_sTextData "Зпрещено открывать огонь и пересекать границу, если противник не открывал огонь по вам или не пересекал границу."\
  ""\
  "Спецназу можно пересекать границу до эскалации (однако необходимо действовать незаметно)."\
  ""\
  "Спецназу можно оказать поддержку британскому спецназу (опционально)."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
}