$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 983.255 0 6133.725
  m_sTitle "Описание миссии"
  m_sTextData "ВС США планируют захватить связной пункт ВС РФ на высоте 220."
  m_aVisibleForFactions {
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 983.158 0 6133.815
  m_sTitle "Описание миссии"
  m_sTextData "Мы планируем провести провести наступательную операцию в этом районе. Однако нам мешает передовой наблюдательный и связной пункт русских на высоте 220. Из-за ПВО противника мы не можем просто взять и разбомбить его. Вашей роте необходимо захватить эту высоту, предварительно зачистив её от противника."\
  "Будьте аккуратны, так как действовать придётся ночью. Из-за срочности проведения операции мы не можем оснастить вас должным образом, действуйте тем, что есть."\
  "Также обратите внимание, что у вас на руках устаревшие карты местности. Сейчас местность немного изменилась, отталкивайтесь от этого. Удачи."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
 {
  coords 983.184 0 6133.813
  m_sTitle "Описание миссии"
  m_sTextData "Местные информаторы докладывают о повышенной активности ВС США в нашем секторе. Вероятно они собираются устроить провакацию. Будьте на чеку."\
  " Из-за праздников личный состав нашего поста слегка сократился, так что вся надежда только на вас. Если американцы нападут на наш пункт связи, то на помощь придёт взвод мотострелков на БТРах с аэродрома в Ландау. Также у нас здесь завалялся ПТРК \"Корнет\", приведите его к бою и приготовьтесь применить его."\
  "Сегодня на нашем пункте никто спать не будет. Объявлена повышенная боевая готовность."\
  ""\
  "Враг не пройдёт!"
  m_aVisibleForFactions {
   "RHS_AFRF"
  }
 }
 {
  coords 983.245 0 6133.85
  m_sTitle "Общие правила"
  m_sTextData "ВСЕМ ЗАПРЕЩЕНО:"\
  "— надевать форму и элементы снаряжения противника, рюкзаки можно;"\
  "— вертолёту запрещена тактика тарана;"\
  "— отделениям Активов (красные) запрещено выходить из красного триггера."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ВС США:"\
  "— захватить высоту (поменять флаг взаимодействием);"\
  "— разгромить противника."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ЗА ВС РФ:"\
  "— удержать высоту (не дать поменять флаг взаимодействием);"\
  "— разгромить противника."\
  ""\
  "ВАЖНО:"\
  "Флаг не перезахватываемый."\
  ""
  m_aVisibleForFactions {
   "Ses_TKA"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}