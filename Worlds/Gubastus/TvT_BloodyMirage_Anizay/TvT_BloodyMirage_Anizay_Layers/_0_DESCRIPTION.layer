$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "ЛОР"
  m_sTextData "Начало Третьей мировой войны. ВСРФ уничтожают аэродромы вокруг своих территорий. В этой миссии необходимо уничтожить аэродром в пустыне."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "1. Вертолетам запрещено использовать технику \"Камикадзе\"."\
  "2. Zu-23 запрещено вывозить за пределы триггера."\
  ""\
  "Задачи ВС РФ:"\
  "  Захватить аэродром, или уничтожить 4 вражеские Zu-23."\
  ""\
  "Задачи ВС США:"\
  "  Не дать захватить аэродром."\
  "  Не дать уничтожить 4 Zu-23."\
  ""\
  "* Синяя зона - зона триггера."\
  "* Захватить - иметь численное преимущество на территории триггера на протяжении 5 минут."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}