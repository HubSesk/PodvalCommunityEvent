$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "ЛОР"
  m_sTextData "Война во вьетнаме. США обнаружили остров, критически важный для логистики Вьетконга. США планируют зачистить берег, после чего основать на нем базу, для дальнейшей зачистки острова."
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "1. США разрешена высадка только внутри черной зоны."\
  "2. Вертолетам запрещено использовать тактику \"Камикадзе\"."\
  ""\
  "Задача США:"\
  "  Захватить береговую зону с окопами."\
  "  Захватить деревню."\
  ""\
  "Задача Вьетконга:"\
  "  Удержать береговую зону с окопами."\
  "  Удержать деревню."\
  ""\
  "* Захватить: Держать численное преимущество на территории в течении 5 минут (Войска США > Войска Вьетконга * 5)."\
  ""\
  "* Зеленая зона - деревня"\
  "* Синяя зона - береговая зона"
 }
}