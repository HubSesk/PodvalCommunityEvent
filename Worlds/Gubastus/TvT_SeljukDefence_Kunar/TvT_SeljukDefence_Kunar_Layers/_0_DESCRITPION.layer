$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "ЛОР"
  m_sTextData "Чеченская война. СССР Захватили замок и укрепили его. Чеченцы идут на штурм."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "1. Вертолету запрещено таранить противника."\
  ""\
  "Задача СССР:"\
  "  Удержать флаг."\
  ""\
  "Задача Чеченцев:"\
  "  Захватить флаг."\
  ""\
  "Дополнительно:"\
  "  Замок хорошо укреплен, рекомендуется взять как можно больше взрывчатки, расположенной на спавне отрядов, чтобы взорвать препятствия на проходах."\
  "  У СССР имеются строительные грузовики, с помощью которых можно построить дополнительные укрепления на фризтайме."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}