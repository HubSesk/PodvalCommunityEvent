$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "ВС США захватили аэродром, теперь его необходимо удержать от контратаки ВС РФ. Также ВС США нашли 2 установки \"Корнет\" в аэродроме."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ПРАВИЛА"\
  "• Вертолётом управляют только пилоты"\
  "• Запрещена доставка пилотов к вертолёту"\
  ""\
  "ЗАДАЧИ"\
  "— ВС РФ: захватить военный объект"\
  "— ВС США: удержать военный объект"\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "• ВС США: 2 установки \"Корнет\""\
  "• Военный объект: синяя зона"\
  "• Захват: контроль 3 мин. при соотношении 2:1"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 KORNET {
  coords 6175.882 109.313 11791.729
  m_sTitle "Корнет"
  m_sTextData "ИНСТРУКЦИЯ ПО СБОРКЕ «КОРНЕТА»"\
  ""\
  "1. Взять гаечный ключ"\
  "2. Разобрать систему на оптику и треногу"\
  "3. Погрузить компоненты в транспорт"\
  "4. Разгрузить треногу и прицел"\
  "5. Совместить треногу с прицелом (гаечный ключ)"\
  "6. Зарядить установку (гаечный ключ + заряд)"\
  "7. Система готова к применению"
  m_aVisibleForFactions {
   "RHS_USAF"
  }
 }
}